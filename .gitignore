# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files (never commit secrets)
.env
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local

# credentials (never commit)
*service-account*.json
*service_account*.json
*-service-role*

# typescript
*.tsbuildinfo
next-env.d.ts

# editor
.idea
.vscode/*
!.vscode/extensions.json

# Impeccable local artifacts — review captures and per-machine config are not shared state.
# .impeccable/surfaces/ IS committed: it holds the durable direction contract.
/.impeccable/review/
/.impeccable/build/
/.impeccable/mocks/
/.impeccable/config.local.json
/.impeccable/questions/

# Impeccable is a design tool, not project state. Reinstall with:
#   npx impeccable install --providers=claude --scope=project
# The design OUTPUTS (PRODUCT.md, DESIGN.md, .impeccable/surfaces/) are committed.
/.claude/skills/impeccable/
/.claude/agents/impeccable-*.md
