# ── public site ──────────────────────────────────────────────────────────────
# Canonical origin, used by the sitemap and robots file. Must be set before launch
# or the sitemap advertises URLs on a domain nobody owns.
NEXT_PUBLIC_SITE_URL=

# ── storage ──────────────────────────────────────────────────────────────────
# memory  = zero-config local dev and tests
# supabase = Postgres + Auth + RLS (staging/production)
STORAGE_BACKEND=memory

# ── Supabase ─────────────────────────────────────────────────────────────────
# Required only when STORAGE_BACKEND=supabase.
# URL and ANON key are safe in the browser. The SERVICE_ROLE key bypasses RLS —
# keep it server-only and NEVER prefix it with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── admin access ─────────────────────────────────────────────────────────────
# Comma-separated allow-list. These addresses must ALSO exist in the
# public.admin_users table for RLS to treat them as admins.
ADMIN_EMAILS=
ADMIN_PASSWORD=

# ── tracking / attribution ───────────────────────────────────────────────────
REDIRECT_COOKIE_DOMAIN=.reylix.com
REDIRECT_BASE_URL=https://go.reylix.com
ATTRIBUTION_WINDOW_DAYS=30
CLICK_DEDUP_MINUTES=30
# Comma-separated hosts permitted as ?to= redirect targets (open-redirect allowlist).
ALLOWED_REDIRECT_HOSTS=

# ── email notifications ──────────────────────────────────────────────────────
# While STORAGE_BACKEND=memory, this is the SYSTEM OF RECORD: an emailed submission is the
# only copy that survives the request. The key and sender are required together — a partial
# config sends nothing, deliberately, because a half-working email path looks like it works.
#
# Provider is Resend (https://resend.com). EMAIL_FROM must be a sender Resend has verified
# for your domain; before a domain is verified, onboarding@resend.dev works for testing.
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# Where each form is delivered, routed by the endpoint that received it. These DEFAULT to
# the values shown, so leave them blank unless you need to override one.
#   Contact form (/api/contact)                    -> CONTACT_INQUIRY_EMAIL
#   Become a Partner form (/api/become-a-partner)  -> PUBLISHER_INQUIRY_EMAIL
CONTACT_INQUIRY_EMAIL=
PUBLISHER_INQUIRY_EMAIL=

# Lead notifications only. Leads do not come from a website form. Unset means logged only.
ADMIN_NOTIFY_EMAIL=
# Only needed to point the notifier at a test double. Leave blank in production.
EMAIL_API_ENDPOINT=

# ── tests ────────────────────────────────────────────────────────────────────
# Set to 1 (with the Supabase vars above, pointed at a DISPOSABLE project) to run the
# shared repository contract test against the live Supabase adapter as well as memory.
RUN_SUPABASE_CONTRACT=

# Set to 1 to run the database-level RLS verification suite. Requires two auth users,
# each linked to an ACTIVE publisher row. See docs/supabase-setup.md.
RUN_SUPABASE_RLS=
RLS_TEST_A_EMAIL=
RLS_TEST_A_PASSWORD=
RLS_TEST_B_EMAIL=
RLS_TEST_B_PASSWORD=
